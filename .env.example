# Staging: https://livsighttest.didierdjakoua.site
# Local simulator:  http://localhost:4040
# Physical device:  http://<LAN-IP>:4040 (same subnet as phone — see Metro URL in expo start)
EXPO_PUBLIC_GATEWAY_URL=http://localhost:4040

# Push — set to true to test on a physical device in dev (disabled by default in __DEV__)
# EXPO_PUBLIC_ENABLE_PUSH=true

# PostHog analytics — DEV project key from eu.posthog.com (Project Settings → Project API Key).
# Leave empty to disable analytics entirely. Prod key goes in eas.json, never here.
# EXPO_PUBLIC_POSTHOG_API_KEY=phc_...
# EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
